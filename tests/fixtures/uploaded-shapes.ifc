ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition[DesignTransferView]'),'2;1');
FILE_NAME('uploaded-shapes.ifc','2026-10-18T21:50:00',(''),(''),'Eng Gustavo G regression fixture','Eng Gustavo G','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('1UPLOADEDPROJECT00000000',$,'Uploaded IFC regression shapes',$,$,$,$,(#10),#5);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#4=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#5=IFCUNITASSIGNMENT((#2,#3,#4));
#6=IFCCARTESIANPOINT((0.,0.,0.));
#7=IFCDIRECTION((0.,0.,1.));
#8=IFCDIRECTION((1.,0.,0.));
#9=IFCAXIS2PLACEMENT3D(#6,#7,#8);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#9,$);
#11=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#12=IFCSITE('1UPLOADSITE0000000000000',$,'Site',$,$,$,$,$,$,$,$,$,$);
#13=IFCBUILDINGSTOREY('1UPLOADSTOREY000000000',$,'Regression storey',$,$,$,$,$,$,$);
#14=IFCRELAGGREGATES('1UPLOADAGGREGATE000000',$,$,$,#1,(#12));
#15=IFCRELAGGREGATES('1UPLOADAGGREGATE000001',$,$,$,#12,(#13));
#16=IFCRELCONTAINEDINSPATIALSTRUCTURE('1UPLOADCONTAINED000000',$,$,$,(#100,#200,#300),#13);
#20=IFCDIRECTION((1.,0.,0.));
#21=IFCDIRECTION((0.,1.,0.));
#22=IFCCARTESIANPOINT((0.,0.));
#23=IFCAXIS2PLACEMENT2D(#22,$);

/* Beam V1: B=0.15 m, H=0.30 m, L=2.375 m. Local Z is rotated to world X. */
#101=IFCRECTANGLEPROFILEDEF(.AREA.,'V1 15x30',#23,0.15,0.30);
#102=IFCCARTESIANPOINT((0.,0.,0.));
#103=IFCAXIS2PLACEMENT3D(#102,$,$);
#104=IFCEXTRUDEDAREASOLID(#101,#103,#7,2.375);
#105=IFCSHAPEREPRESENTATION(#11,'Body','SweptSolid',(#104));
#106=IFCPRODUCTDEFINITIONSHAPE($,$,(#105));
#107=IFCCARTESIANPOINT((0.,0.,1.50));
#108=IFCAXIS2PLACEMENT3D(#107,#20,#21);
#109=IFCLOCALPLACEMENT($,#108);
#100=IFCBEAM('1UPLOADBEAMV10000000000',$,'V1',$,$,#109,#106,$,$);

/* Column P1: B=0.15 m, H=0.30 m, vertical length=1.10 m. */
#201=IFCRECTANGLEPROFILEDEF(.AREA.,'P1 15x30',#23,0.15,0.30);
#202=IFCCARTESIANPOINT((0.,0.,0.));
#203=IFCAXIS2PLACEMENT3D(#202,$,$);
#204=IFCEXTRUDEDAREASOLID(#201,#203,#7,1.10);
#205=IFCSHAPEREPRESENTATION(#11,'Body','SweptSolid',(#204));
#206=IFCPRODUCTDEFINITIONSHAPE($,$,(#205));
#207=IFCCARTESIANPOINT((4.,0.,0.));
#208=IFCAXIS2PLACEMENT3D(#207,#7,#8);
#209=IFCLOCALPLACEMENT($,#208);
#200=IFCCOLUMN('1UPLOADCOLUMNP100000000',$,'P1',$,$,#209,#206,$,$);

/* Narrow slab L1: plan 6.45 x 0.10 m and thickness 0.10 m. */
#301=IFCRECTANGLEPROFILEDEF(.AREA.,'L1 645x10',#23,6.45,0.10);
#302=IFCCARTESIANPOINT((0.,0.,0.));
#303=IFCAXIS2PLACEMENT3D(#302,$,$);
#304=IFCEXTRUDEDAREASOLID(#301,#303,#7,0.10);
#305=IFCSHAPEREPRESENTATION(#11,'Body','SweptSolid',(#304));
#306=IFCPRODUCTDEFINITIONSHAPE($,$,(#305));
#307=IFCCARTESIANPOINT((0.,2.,0.));
#308=IFCAXIS2PLACEMENT3D(#307,#7,#8);
#309=IFCLOCALPLACEMENT($,#308);
#300=IFCSLAB('1UPLOADSLABL10000000000',$,'L1',$,$,#309,#306,$,$);
ENDSEC;
END-ISO-10303-21;
