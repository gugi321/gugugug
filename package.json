{
  "name": "gustavogil-ifc-viewer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "scripts": {
    "check:cad-deps": "node scripts/check-cad-deps.mjs",
    "build:cad": "npm run check:cad-deps && vite build --config vite.cad.config.ts && node scripts/validate-cad-build.mjs",
    "validate:cad": "node scripts/validate-cad-build.mjs"
  },
  "dependencies": {
    "@mlightcad/cad-simple-ui-plugin": "1.7.4",
    "@mlightcad/cad-simple-viewer": "1.7.4",
    "@mlightcad/data-model": "1.15.1",
    "@mlightcad/libredwg-converter": "3.15.1",
    "@mlightcad/mtext-parser": "1.5.3",
    "@mlightcad/mtext-renderer": "0.13.2",
    "@netlify/blobs": "10.1.0"
  },
  "devDependencies": {
    "typescript": "5.5.2",
    "vite": "6.4.3",
    "vite-plugin-static-copy": "4.1.1"
  }
}
